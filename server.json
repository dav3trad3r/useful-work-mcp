{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.usefulwork/useful-work",
  "title": "Useful Work",
  "description": "Find and fix mistakes on your live website: wording, broken links, slow pages, certificate, domain.",
  "version": "1.0.1",
  "websiteUrl": "https://usefulwork.app/builders#mcp",
  "repository": {
    "url": "https://github.com/dav3trad3r/useful-work-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://usefulwork.app/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://usefulwork.app/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer followed by your Useful Work API key. Make one at https://usefulwork.app/app?page=connect",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Your Useful Work API key (uwk_…)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
